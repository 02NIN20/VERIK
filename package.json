{
  "name": "verik",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "postinstall": "pnpm db:generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @verik/db exec prisma generate",
    "db:migrate": "pnpm --filter @verik/db exec prisma migrate deploy",
    "db:push": "pnpm --filter @verik/db exec prisma db push",
    "db:seed": "pnpm --filter @verik/db exec prisma db seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
